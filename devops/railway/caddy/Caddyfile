# Railway reverse proxy: caddy is the only public service. Every backend route
# lives under /api (see backend/main.py), so that one prefix goes to the
# backend and everything else to the SvelteKit frontend, both over Railway's
# IPv6 private network. Railway terminates TLS at the edge and forwards plain
# HTTP to :8080.
{
	auto_https off
	admin off
}

:8080 {
	handle /api/* {
		# The frontend's SSR calls come back in here via caddy.railway.internal:8080,
		# a different origin from the page, and SvelteKit refuses a cross-origin
		# response with no Access-Control-Allow-Origin. Naming the site's own
		# origin grants nothing same-origin does not already allow. Deferred (>)
		# so it replaces, rather than doubles, the one the backend sends for
		# COMPARIA_APP_URL.
		header >Access-Control-Allow-Origin "https://{$RAILWAY_PUBLIC_DOMAIN}"
		reverse_proxy backend.railway.internal:80
	}

	handle {
		reverse_proxy frontend.railway.internal:3000
	}
}
